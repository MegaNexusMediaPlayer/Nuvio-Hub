<?xml version='1.0' encoding='utf-8'?>
<addon id="script.nuvio" name="Nuvio" version="6.0.25" provider-name="Nuvio community build">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="plugin.video.nuviohub" version="6.0.25" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <language>en</language>
    <license>MegaNexus License (see LICENSE.txt)</license>
    <summary lang="en_GB">Nuvio home, collections and simple settings.</summary>
    <description lang="en_GB">Independent interface using Nuvio Hub for catalogs, account state and playback. Configured metadata supplies details and searchable catalogs; individually enabled stream add-ons supply ordered sources. Bundled local updates only.</description>
    <assets>
      <icon>resources/media/meganexus_icon.png</icon>
      <fanart>resources/media/meganexus_fanart.png</fanart>
    </assets>
  </extension>
</addon>