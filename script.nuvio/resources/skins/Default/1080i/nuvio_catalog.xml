<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">500</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture colordiffuse="FF090B11">special://home/addons/script.nuvio/resources/media/white.png</texture>
    </control>
    <control type="group">
      <width>1920</width>
      <height>1080</height>
      <animation effect="fade" start="0" end="100" time="160">WindowOpen</animation>
      <control type="label">
        <left>70</left>
        <top>28</top>
        <width>1360</width>
        <height>68</height>
        <font>font37</font>
        <textcolor>FFFFFFFF</textcolor>
        <label>$INFO[Window.Property(nuvio.title)]</label>
      </control>
      <control type="group">
        <visible>!String.IsEmpty(Weather.Temperature)</visible>
        <control type="image">
          <left>1590</left>
          <top>35</top>
          <width>48</width>
          <height>48</height>
          <aspectratio>scale</aspectratio>
          <texture>special://home/addons/skin.nuvio/media/nuvio/weather/$INFO[Weather.FanartCode].png</texture>
        </control>
        <control type="label">
          <left>1645</left>
          <top>39</top>
          <width>110</width>
          <height>40</height>
          <font>font12</font>
          <textcolor>FFC2ADFF</textcolor>
          <label>$INFO[Weather.Temperature]</label>
        </control>
      </control>
      <control type="label">
        <left>1750</left>
        <top>39</top>
        <width>130</width>
        <height>40</height>
        <font>font12</font>
        <textcolor>FFCAD0DB</textcolor>
        <label>$INFO[System.Time(hh:mm)]</label>
      </control>
      <control type="panel" id="500">
        <left>60</left>
        <top>125</top>
        <width>1800</width>
        <height>830</height>
        <onup>500</onup>
        <ondown>501</ondown>
        <viewtype label="Posters">icon</viewtype>
        <scrolltime>180</scrolltime>
        <itemlayout width="225" height="386">
          <control type="image">
            <left>12</left>
            <top>5</top>
            <width>196</width>
            <height>294</height>
            <aspectratio>scale</aspectratio>
            <texture diffuse="special://home/addons/script.nuvio/resources/media/nuvio_poster_mask_v2.png">$INFO[ListItem.Art(poster)]</texture>
          </control>
          <control type="textbox">
            <left>12</left>
            <top>308</top>
            <width>202</width>
            <height>65</height>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
          <control type="image">
            <left>167</left>
            <top>10</top>
            <width>36</width>
            <height>36</height>
            <aspectratio>keep</aspectratio>
            <texture>special://home/addons/skin.nuvio/media/nuvio/watched_hd.png</texture>
            <visible>String.IsEqual(ListItem.Property(watched),1)</visible>
          </control>
        </itemlayout>
        <focusedlayout width="225" height="386">
          <control type="image">
            <left>12</left>
            <top>5</top>
            <width>196</width>
            <height>294</height>
            <aspectratio>scale</aspectratio>
            <texture diffuse="special://home/addons/script.nuvio/resources/media/nuvio_poster_mask_v2.png">$INFO[ListItem.Art(poster)]</texture>
          </control>
          <control type="image">
            <left>8</left>
            <top>1</top>
            <width>204</width>
            <height>302</height>
            <aspectratio>scale</aspectratio>
            <texture>special://home/addons/script.nuvio/resources/media/nuvio_poster_focus_v2.png</texture>
            <visible>Control.HasFocus(500)</visible>
          </control>
          <control type="textbox">
            <left>12</left>
            <top>308</top>
            <width>202</width>
            <height>65</height>
            <font>font12</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
          <control type="image">
            <left>167</left>
            <top>10</top>
            <width>36</width>
            <height>36</height>
            <aspectratio>keep</aspectratio>
            <texture>special://home/addons/skin.nuvio/media/nuvio/watched_hd.png</texture>
            <visible>String.IsEqual(ListItem.Property(watched),1)</visible>
          </control>
        </focusedlayout>
      </control>
      <control type="button" id="501">
        <left>740</left>
        <top>988</top>
        <width>440</width>
        <height>62</height>
        <font>font13</font>
        <label>Load more</label>
        <align>center</align>
        <aligny>center</aligny>
        <textcolor>FFFFFFFF</textcolor>
        <focusedcolor>FF090B11</focusedcolor>
        <texturefocus border="22">special://home/addons/script.nuvio/resources/media/nuvio_pill.png</texturefocus>
        <texturenofocus border="22" colordiffuse="FF252A38">special://home/addons/script.nuvio/resources/media/nuvio_pill.png</texturenofocus>
        <onleft>500</onleft>
        <onright>500</onright>
        <ondown>500</ondown>
      </control>
    </control>
  </controls>
</window>