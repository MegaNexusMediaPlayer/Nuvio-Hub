<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">100</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture colordiffuse="FF040F22">special://home/addons/script.nuvio/resources/media/white.png</texture>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture>$INFO[Window.Property(nuvio.background)]</texture>
      <!-- Video mode: black background only, so a loop restart never flashes the artwork. -->
      <visible>String.IsEmpty(Window.Property(nuvio.saver.mode))</visible>
    </control>
    <!-- Built-in MegaNexus animation: drawn by Kodi's GUI (no player, no mute),
         glow pulse, gentle logo breathing and a light orbiting the M. -->
    <control type="group">
      <visible>String.IsEqual(Window.Property(nuvio.saver.mode),animated)</visible>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <aspectratio>scale</aspectratio>
        <texture>special://home/addons/script.nuvio/resources/media/meganexus_saver_bg.png</texture>
      </control>
      <control type="image">
        <left>50</left><top>-20</top><width>1000</width><height>1000</height>
        <texture>special://home/addons/script.nuvio/resources/media/meganexus_saver_glow.png</texture>
        <animation effect="fade" start="35" end="100" time="4000" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>special://home/addons/script.nuvio/resources/media/meganexus_saver_logo.png</texture>
        <animation effect="zoom" start="100" end="102.5" center="960,470" time="5000" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
      </control>
      <!-- Orbit: x and y move sinusoidally a quarter period apart (an ellipse),
           tilted like the ring; the light dims while it passes behind the M. -->
      <control type="group">
        <animation effect="rotate" start="16" end="16" center="552,472" time="0" condition="true">Conditional</animation>
        <control type="group">
          <animation effect="slide" start="-228,0" end="228,0" time="3000" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
          <control type="image">
            <left>507</left><top>427</top><width>90</width><height>90</height>
            <texture>special://home/addons/script.nuvio/resources/media/meganexus_saver_spark.png</texture>
            <animation effect="slide" start="0,-92" end="0,92" time="3000" delay="1500" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
            <animation effect="fade" start="15" end="100" time="3000" delay="1500" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
          </control>
        </control>
      </control>
    </control>
    <control type="videowindow">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <visible>String.IsEqual(Window.Property(nuvio.saver.video),1)</visible>
    </control>
    <control type="group">
      <visible>!String.IsEmpty(Weather.Temperature)</visible>
      <control type="image">
        <left>1590</left>
        <top>35</top>
        <width>48</width>
        <height>48</height>
        <aspectratio>scale</aspectratio>
        <texture>special://home/addons/skin.nuvio/media/nuvio/weather/$INFO[Weather.FanartCode].png</texture>
        <visible>!Skin.HasSetting(nuvio.hideweather) + !String.IsEqual(Window(10000).Property(nuvio.hide_weather_clock),1)</visible>
      </control>
      <control type="label">
        <left>1645</left>
        <top>39</top>
        <width>110</width>
        <height>40</height>
        <font>font12</font>
        <textcolor>FFADD3FF</textcolor>
        <label>$INFO[Weather.Temperature]</label>
        <visible>!Skin.HasSetting(nuvio.hideweather) + !String.IsEqual(Window(10000).Property(nuvio.hide_weather_clock),1)</visible>
      </control>
    </control>
    <control type="label">
      <left>1750</left>
      <top>39</top>
      <width>130</width>
      <height>40</height>
      <font>font12</font>
      <textcolor>FFCAD0DB</textcolor>
      <label>$INFO[System.Time(hh:mm)]</label>
      <visible>!Skin.HasSetting(nuvio.hideweather) + !String.IsEqual(Window(10000).Property(nuvio.hide_weather_clock),1)</visible>
    </control>
  </controls>
</window>