<window>
  <defaultcontrol always="true">100</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture colordiffuse="FF090B11">special://home/addons/script.nuvio/resources/media/white.png</texture>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>scale</aspectratio>
      <texture>$INFO[Window.Property(nuvio.background)]</texture>
    </control>
    <control type="group">
      <visible>!String.IsEmpty(Weather.Temperature)</visible>
      <control type="image">
        <left>1590</left>
        <top>35</top>
        <width>48</width>
        <height>48</height>
        <aspectratio>scale</aspectratio>
        <texture>special://home/addons/skin.nuvio/media/nuvio/weather/$INFO[Weather.FanartCode].png</texture>
      </control>
      <control type="label">
        <left>1645</left>
        <top>39</top>
        <width>110</width>
        <height>40</height>
        <font>font12</font>
        <textcolor>FFC2ADFF</textcolor>
        <label>$INFO[Weather.Temperature]</label>
      </control>
    </control>
    <control type="label">
      <left>1750</left>
      <top>39</top>
      <width>130</width>
      <height>40</height>
      <font>font12</font>
      <textcolor>FFCAD0DB</textcolor>
      <label>$INFO[System.Time(hh:mm)]</label>
    </control>
  </controls>
</window>