<?xml version='1.0' encoding='utf-8'?>
<addon id="repository.meganexus" name="MegaNexus Repository" version="1.0.0" provider-name="MegaNexus">
  <extension point="xbmc.addon.repository" name="MegaNexus Repository">
    <dir minversion="19.0.0">
